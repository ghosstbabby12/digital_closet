# Copia este archivo a .env y completa los valores reales.

# Seguridad
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de datos (por defecto SQLite local; en prod usar Postgres, ej:
# postgresql+psycopg2://user:password@host:5432/closet)
DATABASE_URL=sqlite:///./closet.db

# Clima - OpenWeatherMap (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# IA para sugerencia de outfits: "rule_based" (por defecto, sin costo) o "claude" / "openai"
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Carpeta local donde se guardan las fotos de las prendas
UPLOAD_DIR=./uploads
